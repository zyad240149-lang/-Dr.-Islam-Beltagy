# انسخ الملف ده باسم .env واملا القيم (ملف .env نفسه مستبعد من git)

# --- للواجهة (بتتنشر في المتصفح — مفاتيح عامة فقط) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key من Project Settings → API>

# --- للسكريبتات على جهاز المطوّر فقط (ممنوع تبدأ بـ VITE_) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=<service_role key — صلاحية كاملة>
SUPABASE_ACCESS_TOKEN=<sbp_... personal access token — لتطبيق الهجرات ونشر الدوال>

# --- أول دخول (اختياري — بيستخدمه scripts/e2e.mjs) ---
ADMIN_INITIAL_PHONE=01000000000
ADMIN_INITIAL_PASSWORD=<كلمة المرور اللي اتعمل بيها المدير>
